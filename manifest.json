{
  "manifest_version": 3,
  "name": "Swipe Down to Refresh",
  "version": "1.0.0",
  "description": "Two-finger swipe down at the top of any page to refresh it, with a Safari-style spinner animation.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
